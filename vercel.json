{
  "rewrites": [
    {
      "source": "/api/wallet-link",
      "destination": "/api/wallet?action=link"
    },
    {
      "source": "/api/wallet-update",
      "destination": "/api/wallet?action=update"
    },
    {
      "source": "/api/wallet-hero.png",
      "destination": "/api/wallet?action=hero"
    },
    {
      "source": "/api/send-mail",
      "destination": "/api/core?action=send-mail"
    },
    {
      "source": "/api/health",
      "destination": "/api/core?action=health"
    },
    {
      "source": "/api/profile-publish",
      "destination": "/api/online?action=publish"
    },
    {
      "source": "/api/online-register",
      "destination": "/api/online?action=register"
    },
    {
      "source": "/api/online-pull",
      "destination": "/api/online?action=pull"
    },
    {
      "source": "/r/:slug",
      "destination": "/api/online?action=page&slug=:slug"
    },
    {
      "source": "/api/owner-sync",
      "destination": "/api/owner?action=sync"
    },
    {
      "source": "/api/owner-login",
      "destination": "/api/owner?action=login"
    },
    {
      "source": "/api/owner-data",
      "destination": "/api/owner?action=data"
    },
    {
      "source": "/api/owner-command",
      "destination": "/api/owner?action=command"
    },
    {
      "source": "/owner/:token",
      "destination": "/api/owner?action=page&token=:token"
    },
    {
      "source": "/admin",
      "destination": "/api/core?action=admin-page"
    },
    {
      "source": "/api/admin-login",
      "destination": "/api/core?action=admin-login"
    },
    {
      "source": "/api/admin-data",
      "destination": "/api/core?action=admin-data"
    },
    {
      "source": "/api/admin-action",
      "destination": "/api/core?action=admin-action"
    },
    {
      "source": "/api/apple-link",
      "destination": "/api/apple?action=link"
    },
    {
      "source": "/api/apple-pass",
      "destination": "/api/apple?action=pass"
    },
    {
      "source": "/api/apple-ws/:path*",
      "destination": "/api/apple?action=ws&p=:path*"
    },
    {
      "source": "/api/pos/:key",
      "destination": "/api/online?action=pos-in&key=:key"
    },
    {
      "source": "/api/pos-key",
      "destination": "/api/online?action=pos-key"
    },
    {
      "source": "/api/pos-pull",
      "destination": "/api/online?action=pos-pull"
    },
    {
      "source": "/manage",
      "destination": "/api/core?action=manage"
    },
    {
      "source": "/api/resend-key",
      "destination": "/api/core?action=resend-key"
    },
    {
      "source": "/api/trial-start",
      "destination": "/api/core?action=trial-start"
    },
    {
      "source": "/api/sync/:op",
      "destination": "/api/core?action=sync&op=:op"
    },
    {
      "source": "/api/owner-code",
      "destination": "/api/owner?action=auth&op=code"
    },
    {
      "source": "/api/owner-code-login",
      "destination": "/api/owner?action=auth&op=code-login"
    },
    {
      "source": "/api/owner-logout-all",
      "destination": "/api/owner?action=auth&op=logout-all"
    },
    {
      "source": "/owner",
      "destination": "/api/owner?action=page"
    }
  ],
  "functions": {
    "api/wallet.js": {
      "includeFiles": "api/fonts/**"
    },
    "api/core.js": {
      "includeFiles": "api/fonts/**"
    },
    "api/apple.js": {
      "includeFiles": "api/fonts/**"
    }
  },
  "headers": [
    {
      "source": "/((?!admin$|owner/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/owner/:token",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
