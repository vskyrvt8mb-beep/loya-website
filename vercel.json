      "destination": "/api/online?action=dk-start"
    },
    {
      "source": "/api/dk-status",
      "destination": "/api/online?action=dk-status"
    },
    {
      "source": "/api/dk-disconnect",
      "destination": "/api/online?action=dk-disconnect"
    },
    {
      "source": "/api/book-slots",
      "destination": "/api/online?action=book-slots"
    },
    {
      "source": "/api/book-info",
      "destination": "/api/online?action=book-info"
